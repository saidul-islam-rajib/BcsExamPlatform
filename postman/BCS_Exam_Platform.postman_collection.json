                {
                    "name": "Submit Exam",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    var jsonData = pm.response.json();",
                                    "    console.log(\"Exam Result:\");",
                                    "    console.log(\"Total Marks: \" + jsonData.totalMarksObtained + \"/\" + jsonData.totalMarks);",
                                    "    console.log(\"Rank: \" + jsonData.rank);",
                                    "    console.log(\"Badge: \" + jsonData.badgeName);",
                                    "    console.log(\"Passed: \" + jsonData.isPassed);",
                                    "}"
